<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chess.Ui.App"
             xmlns:local="using:Chess.Ui"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Chess.Ui/Styles/Colors.axaml" />
                <ResourceInclude Source="avares://Chess.Ui/Controls/Controls.axaml"/>
                <ResourceInclude Source="avares://Chess.Ui/Styles/ControlThemes/ControlThemes.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Chess.Ui/Styles/Styles.axaml"/>
    </Application.Styles>
</Application>