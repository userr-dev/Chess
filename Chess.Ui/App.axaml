<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chess.Ui.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Chess/Styles/Colors.axaml" />
                <ResourceInclude Source="avares://Chess/Controls/Controls.axaml"/>
                <ResourceInclude Source="avares://Chess/Styles/ControlThemes/ControlThemes.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <FontFamily x:Key="FontAwesome">avares://Chess/Assets/Fonts/#Font Awesome 7</FontFamily>
    </Application.Resources>
    
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Chess/Styles/Styles.axaml"/>
    </Application.Styles>
</Application>