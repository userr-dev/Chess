<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:ia="using:Avalonia.Xaml.Interactions.Core"
             xmlns:controls="using:Chess.Ui.Controls"
             xmlns:vm="using:Chess.Ui.ViewModels"
             xmlns:v="using:Chess.Ui.Views"
             mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="680"
             x:Class="Chess.Ui.Views.BoardView"
             x:DataType="vm:BoardViewModel">
    <Grid ColumnDefinitions="Auto, *, Auto"
          RowDefinitions="Auto, *, Auto"
          VerticalAlignment="Center"
          HorizontalAlignment="Center"
          Background="{StaticResource ChessBoardBorderBrush}">

        <controls:BoardAxisLabels Grid.Column="1"
                                  Grid.Row="0"
                                  Orientation="Horizontal"
                                  Margin="0,5"
                                  ItemsSource="{Binding Columns}" />

        <controls:BoardAxisLabels Grid.Column="1"
                                  Grid.Row="2"
                                  Orientation="Horizontal"
                                  Margin="0,5"
                                  ItemsSource="{Binding Columns}" />

        <controls:BoardAxisLabels Grid.Column="0"
                                  Grid.Row="1"
                                  Orientation="Vertical"
                                  Margin="10,0"
                                  ItemsSource="{Binding Rows}" />

        <controls:BoardAxisLabels Grid.Column="2"
                                  Grid.Row="1"
                                  Orientation="Vertical"
                                  Margin="10,0"
                                  ItemsSource="{Binding Rows}" />

        <ItemsControl Grid.Row="1"
                      Grid.Column="1"
                      Width="640"
                      Height="640"
                      ItemsSource="{Binding Squares}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="8"
                                 Columns="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SquareViewModel">
                    <Border Classes.lightSquare="{Binding IsLightSquare}"
                            Classes.darkSquare="{Binding !IsLightSquare}">
                        <i:Interaction.Behaviors>
                            <ia:EventTriggerBehavior EventName="Tapped">
                                <InvokeCommandAction
                                    Command="{Binding $parent[ItemsControl].((vm:BoardViewModel)DataContext)?.SelectSquareCommand}"
                                    CommandParameter="{Binding}" />
                            </ia:EventTriggerBehavior>
                        </i:Interaction.Behaviors>

                        <Grid>
                            <Border Classes.canMove="{Binding CanMovable}"
                                    Classes.canAttack="{Binding CanAttack}"
                                    Classes.kingChecked="{Binding IsKingChecked}"
                                    Margin="6">
                            </Border>
                            <Image Source="{Binding PieceImage}"
                                   Margin="4"
                                   Stretch="Uniform" />
                        </Grid>

                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <v:PromotionMenu Grid.Row="0" 
                         Grid.Column="0" 
                         Grid.ColumnSpan="3"
                         Grid.RowSpan="3"
                         DataContext="{Binding PromotionMenuViewModel}" />
        
    </Grid>
</UserControl>