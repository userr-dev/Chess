<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add Resources Here -->
    
    <Design.PreviewWith>
        <RadioButton Theme="{StaticResource CardRadioButtonTheme}"
                     IsChecked="True"
                     Content="3 min"/>
    </Design.PreviewWith>
    
    <ControlTheme x:Key="CardRadioButtonTheme" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource LightSquareBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Height" Value="50"/>
        
        <Setter Property="Template">
            <ControlTemplate TargetType="RadioButton">
                <Border x:Name="PART_OuterBorder"
                        Padding="2"
                        CornerRadius="8"
                        BorderThickness="2"
                        BorderBrush="{TemplateBinding BorderBrush}">
                    
                    <Border x:Name="PART_InnerBorder"
                            CornerRadius="6"
                            Background="{StaticResource DarkSquareBrush}">
                        
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Center"/>
                        
                    </Border>
                    
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:checked">
            <Setter Property="BorderBrush" Value="{StaticResource LightSquareBrush}" />
        </Style>
    </ControlTheme>
    
</ResourceDictionary>
